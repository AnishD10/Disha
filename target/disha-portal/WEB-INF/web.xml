<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Disha Nepal Career Intelligence Portal</display-name>

    <!-- Default welcome file. Replace with your project's actual login or home page. -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!--
        All servlets are registered via @WebServlet annotations so no
        <servlet> entries are needed here. This file only sets the app
        display name and welcome file. Add session timeout or error pages
        below as other features are merged in.
    -->

    <!-- Optional: redirect unhandled 404 and 500 errors to a friendly page -->
    <!--
    <error-page>
        <error-code>404</error-code>
        <location>/jsp/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/jsp/error/500.jsp</location>
    </error-page>
    -->

    <!-- Session timeout in minutes. 30 minutes is a safe default. -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
