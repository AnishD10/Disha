classDiagram
    class BaseDAO {
        <<abstract>>
        #getConnection() Connection
        #closeResultSet(rs: ResultSet): void
        #closePreparedStatement(ps: PreparedStatement): void
        #closeConnection(conn: Connection): void
        #closeAllResources(rs: ResultSet, ps: PreparedStatement, conn: Connection): void
        #closeResources(ps: PreparedStatement, conn: Connection): void
        #executeUpdate(sql: String, params: Object...): int
        #executeQuery(sql: String, params: Object...): ResultSet
        #setParameters(ps: PreparedStatement, params: Object...): void
        #logError(message: String, e: Exception): void
    }

    class UserDAO {
        +addUser(user: User): void
        +getUserById(userId: int): User
        +updateUser(user: User): void
        +deleteUser(userId: int): void
        +getAllUsers(): List~User~
        +getUserByEmail(email: String): User
    }

    class StudentProfileDAO {
        +addProfile(profile: StudentProfile): void
        +getProfileByStudentId(studentId: int): StudentProfile
        +updateProfile(profile: StudentProfile): void
        +deleteProfile(profileId: int): void
    }

    class AssessmentDAO {
        +addAssessment(assessment: Assessment): void
        +getAssessmentById(assessmentId: int): Assessment
        +getAllAssessments(): List~Assessment~
        +updateAssessment(assessment: Assessment): void
        +deleteAssessment(assessmentId: int): void
    }

    class QuestionDAO {
        +addQuestion(question: Question): void
        +getQuestionsByAssessmentId(assessmentId: int): List~Question~
        +updateQuestion(question: Question): void
        +deleteQuestion(questionId: int): void
    }

    class CareerDAO {
        +addCareer(career: Career): void
        +getCareerById(careerId: int): Career
        +getAllCareers(): List~Career~
        +getCareersByDemand(demand: String): List~Career~
        +updateCareer(career: Career): void
        +deleteCareer(careerId: int): void
    }

    class CollegeDAO {
        +addCollege(college: College): void
        +getCollegeById(collegeId: int): College
        +getAllColleges(): List~College~
        +getCollegesByLocation(location: String): List~College~
        +updateCollege(college: College): void
        +deleteCollege(collegeId: int): void
    }

    class DegreeDAO {
        +addDegree(degree: Degree): void
        +getDegreeById(degreeId: int): Degree
        +getDegreesByCollege(collegeId: int): List~Degree~
        +updateDegree(degree: Degree): void
        +deleteDegree(degreeId: int): void
    }

    class DecisionPlanDAO {
        +addPlan(plan: DecisionPlan): void
        +getPlanById(planId: int): DecisionPlan
        +getPlansByStudent(studentId: int): List~DecisionPlan~
        +updatePlan(plan: DecisionPlan): void
        +deletePlan(planId: int): void
    }

    BaseDAO <|-- UserDAO
    BaseDAO <|-- StudentProfileDAO
    BaseDAO <|-- AssessmentDAO
    BaseDAO <|-- QuestionDAO
    BaseDAO <|-- CareerDAO
    BaseDAO <|-- CollegeDAO
    BaseDAO <|-- DegreeDAO
    BaseDAO <|-- DecisionPlanDAO
